// Antalya Bridge — veritabanı şeması
// PostgreSQL + Prisma. Çok dilli içerik, talep/lead, indirim ve ödeme yöntemleri.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum LeadStatus {
  NEW
  CONTACTED
  CONFIRMED
  DONE
  ARCHIVED
}

enum Channel {
  WEB
  WHATSAPP
  TELEGRAM
}

enum PromoType {
  PERCENT
  AMOUNT
}

enum PaymentType {
  KASPI
  CRYPTO
}

// Fatura/sipariş durumu (kripto ağ geçidi akışı)
enum InvoiceStatus {
  PENDING // oluşturuldu, ödeme bekleniyor
  PAID // tam ödendi (paid / paid_over)
  UNDERPAID // eksik ödendi (wrong_amount) — elle kontrol
  EXPIRED // süresi doldu
  CANCELLED // admin iptal etti
  FAILED // sağlayıcı başarısız bildirdi
}

// --- Yönetim ---
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String // bcrypt hash
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
}

// --- İçerik (CMS): sayfa -> bölüm -> blok, çok dilli çeviriler ---
model Page {
  id        String    @id @default(cuid())
  slug      String    @unique // home, antalya, lessons, education, about, faq, contact (veya yeni özel slug)
  title     String? // admin listesi / sekme başlığı
  order     Int       @default(0)
  published Boolean   @default(true)
  managed   Boolean   @default(false) // true ise bu rota CMS bloklarıyla render edilir (aksi halde mevcut kodlu tasarım)
  sections  Section[]
  blocks    ContentBlock[] @relation("PageBlocks")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Section {
  id        String         @id @default(cuid())
  page      Page           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId    String
  key       String // hero, features, cta...
  type      String         @default("text")
  order     Int            @default(0)
  blocks    ContentBlock[]
}

model ContentBlock {
  id        String        @id @default(cuid())
  section   Section?      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId String?
  page      Page?         @relation("PageBlocks", fields: [pageId], references: [id], onDelete: Cascade)
  pageId    String?
  type      String // hero, heading, richtext, image, imageText, cta, cards, quote
  order     Int           @default(0)
  props     Json? // tipsel, yerelleştirilmeyen ayarlar (image url, href, align, count...)
  mediaId   String?
  media     Media?        @relation(fields: [mediaId], references: [id])
  texts     Translation[]
}

// Çok dilli metin: blok bazlı, alan adı + locale.
model Translation {
  id      String       @id @default(cuid())
  block   ContentBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  blockId String
  field   String // title, body, alt...
  locale  String // tr, en, ru, kk, uz
  value   String       @db.Text

  @@unique([blockId, field, locale])
}

// Site metni override'ları: JSON çeviri dosyalarındaki herhangi bir anahtarı
// (örn. "home.heroTitle") locale bazında admin panelden ezer. Boşsa dosyadaki
// varsayılan kullanılır. Böylece tüm site metinleri panelden düzenlenebilir.
model SiteText {
  id     String @id @default(cuid())
  key    String // noktalı yol: home.heroTitle
  locale String // tr, en, ru, kk, uz
  value  String @db.Text

  @@unique([key, locale])
}

// Site ayarları: API anahtarları + iletişim/site değerleri. Admin panelden
// düzenlenir; kod env yerine önce buradan okur (yoksa env'e düşer). Sırlar
// asla client'a gönderilmez, panelde maskelenir, değişiklik AuditLog'a yazılır.
model Setting {
  key       String   @id // OPENROUTER_API_KEY, WHATSAPP_NUMBER, SITE_URL ...
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Media {
  id        String         @id @default(cuid())
  url       String
  alt       String?
  width     Int?
  height    Int?
  createdAt DateTime       @default(now())
  blocks    ContentBlock[]
}

// --- Hizmetler & dersler ---
model Service {
  id        String   @id @default(cuid())
  slug      String   @unique // antalya, lessons, education
  active    Boolean  @default(true)
  order     Int      @default(0)
}

model LessonType {
  id          String  @id @default(cuid())
  minutes     Int // 15, 30, 60
  price       Int? // admin tarafından girilir (en küçük para birimi cinsinden)
  currency    String  @default("USD")
  active      Boolean @default(true)
  order       Int     @default(0)
}

model AvailabilitySlot {
  id        String   @id @default(cuid())
  startsAt  DateTime
  minutes   Int      @default(30)
  booked    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// --- Talep / Lead (iletişim formu + bot) ---
model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String?
  phone     String?
  service   String? // antalya, lessons, education, other
  message   String     @db.Text
  locale    String     @default("en")
  channel   Channel    @default(WEB)
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())

  @@index([createdAt])
}

// --- İndirim / Promosyon (içerikten bağımsız) ---
model PromoCode {
  id          String    @id @default(cuid())
  code        String    @unique
  type        PromoType @default(PERCENT)
  value       Int // yüzde (0-100) veya tutar
  active      Boolean   @default(true)
  validFrom   DateTime?
  validUntil  DateTime?
  usageLimit  Int? // null = sınırsız
  usedCount   Int       @default(0)
  targetSlug  String? // belirli bir hizmete özel (null = tümü)
  createdAt   DateTime  @default(now())
}

// --- Ödeme yöntemleri (admin yönetir) ---
model PaymentMethod {
  id        String      @id @default(cuid())
  type      PaymentType // KASPI | CRYPTO
  coin      String? // USDT, BTC... (crypto için)
  network   String? // TRC20, ERC20, BTC...
  address   String? // cüzdan adresi veya Kaspi bilgisi
  qrUrl     String?
  active    Boolean     @default(true)
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

// --- Fatura / sipariş (kripto ağ geçidi: Cryptomus vb.) ---
// Admin bir fatura oluşturur → sağlayıcıda barındırılan ödeme sayfası açılır →
// müşteri istediği ağdan (TRC20/SOL/ARB/ETH/BTC...) öder → webhook/senkron ile
// otomatik "PAID" olur → sahibe bildirim gider. Para doğrudan sahibin cüzdanına.
model Invoice {
  id          String        @id @default(cuid())
  ref         String        @unique // insan-okur kısa referans: AB-XXXXXX (order_id)
  amount      Int // ödenecek tutar (indirim SONRASI), en küçük birim (kuruş/cent)
  currency    String        @default("USD") // fiat: USD, EUR, RUB, KZT...
  description String        @db.Text

  // İndirim (uygulandıysa)
  promoCode      String?
  discountAmount Int     @default(0) // en küçük birim

  // Müşteri (opsiyonel)
  customerName  String?
  customerEmail String?
  customerPhone String?
  locale        String  @default("en")

  // İlişki / bağlam
  service      String? // antalya | lessons | education | other
  lessonTypeId String?
  leadId       String?

  // Sağlayıcı
  provider   String  @default("cryptomus")
  providerId String? // Cryptomus payment uuid
  payUrl     String? // barındırılan ödeme sayfası (müşteriye gönderilen link)

  // Durum / sonuç
  status     InvoiceStatus @default(PENDING)
  paidAt     DateTime?
  paidAmount String? // gerçekte ödenen (sağlayıcı raporu; raporlama)
  payCurrency String? // ödenen coin (USDT, BTC...)
  payNetwork String? // tron, eth, bsc, sol, btc...
  txid       String?
  expiresAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// --- Manuel satış defteri: admin elle kaydeder (kime, ne, ücret, indirim, ödeme) ---
model Sale {
  id              String   @id @default(cuid())
  soldAt          DateTime @default(now()) // satış tarihi (düzenlenebilir)
  // Müşteri
  customerName    String
  customerPhone   String?
  customerEmail   String?
  customerIdNo    String? // kimlik / pasaport no
  customerCountry String?
  // Ürün / tur
  service         String? // antalya | lessons | education | it | other
  itemName        String // tur/paket adı (seçili veya serbest)
  // Tutar (en küçük para birimi cinsinden — kuruş/cent)
  amount          Int // liste fiyatı
  currency        String   @default("USD")
  // İndirim
  promoCode       String? // uygulanan kod (varsa)
  discountAmount  Int      @default(0)
  finalAmount     Int // net (amount - discount)
  // Ödeme
  paymentType     String? // KASPI | CRYPTO | CASH | OTHER
  paymentRef      String? // hangi adres/IBAN/txid ile ödendi
  status          String   @default("PAID") // PAID | PENDING | PARTIAL
  paidAmount      Int? // kısmi ödemede ödenen
  note            String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([soldAt])
}

// --- Denetim kaydı: hassas değişiklikler (özellikle ödeme/cüzdan) izlenir ---
model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String // işlemi yapan admin
  action     String // create | update | toggle | delete
  entity     String // PaymentMethod | PromoCode | SiteText ...
  entityId   String?
  details    String?  @db.Text // okunabilir özet (örn. eski/yeni adres)
  createdAt  DateTime @default(now())

  @@index([entity, createdAt])
}

// --- Bot konuşmaları ---
model Conversation {
  id        String    @id @default(cuid())
  channel   Channel
  externalId String // whatsapp/telegram kullanıcı kimliği
  locale    String    @default("en")
  createdAt DateTime  @default(now())
  messages  Message[]

  @@unique([channel, externalId])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  role           String // user | assistant
  content        String       @db.Text
  createdAt      DateTime     @default(now())
}
