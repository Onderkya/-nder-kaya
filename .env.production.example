# Antalya Bridge — ÜRETİM .env örneği.
# Sunucuda `cp .env.production.example .env` yapıp DEĞERLERİ DOLDUR.
# Bu dosyayı (gerçek değerlerle) ASLA git'e commit'leme.

# --- Veritabanı (compose içi Postgres; host'a port açılmaz) ---
# POSTGRES_PASSWORD'u güçlü seç; DATABASE_URL ile AYNI olmalı.
POSTGRES_USER="antalya"
POSTGRES_PASSWORD="DEGISTIR_guclu_db_sifresi"
POSTGRES_DB="antalya"
DATABASE_URL="postgresql://antalya:DEGISTIR_guclu_db_sifresi@db:5432/antalya?schema=public"

# --- Host portu: diğer projeyle çakışmasın diye 3010 (keşifle teyit et) ---
WEB_HTTP_PORT="3010"

# --- AI admin asistanı veritabanı rolleri (opsiyonel) ---
# prisma/sql/ai_roles.sql çalıştırdıktan sonra doldur (parolalar oradakiyle aynı).
AI_READONLY_DATABASE_URL="postgresql://ai_readonly:DEGISTIR_ro_sifresi@db:5432/antalya?schema=public"
# Güvenli yazma (ekle/güncelle; silme yok). İstemiyorsan boş bırak.
AI_READWRITE_DATABASE_URL="postgresql://ai_readwrite:DEGISTIR_rw_sifresi@db:5432/antalya?schema=public"

# --- Oturum (admin) — ZORUNLU: openssl rand -base64 32 ---
AUTH_SECRET="DEGISTIR_openssl_rand_base64_32"

# --- İlk admin (seed) — ZORUNLU: şifre en az 12 karakter ---
ADMIN_EMAIL="onderkya35@gmail.com"
ADMIN_PASSWORD="DEGISTIR_guclu_admin_sifresi"

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://antalyabridge.com"
NEXT_PUBLIC_WHATSAPP="905555555555"
NEXT_PUBLIC_TELEGRAM="antalyabridge"
NEXT_PUBLIC_CONTACT_EMAIL="onderkya35@gmail.com"
NEXT_PUBLIC_INSTAGRAM=""
NEXT_PUBLIC_TIKTOK=""
NEXT_PUBLIC_FACEBOOK=""
NEXT_PUBLIC_YOUTUBE=""

# --- E-posta bildirimi (talep gelince) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="onderkya35@gmail.com"
SMTP_PASS="gmail-uygulama-sifresi"
NOTIFY_EMAIL="onderkya35@gmail.com"

# --- Telegram bildirimi + bot ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_OWNER_CHAT_ID=""
TELEGRAM_WEBHOOK_SECRET=""

# --- AI (Claude) — WhatsApp/Telegram bilgilendirme botu ---
ANTHROPIC_API_KEY=""

# --- Admin AI asistanı (OpenRouter — model serbest) ---
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
OPENROUTER_MODEL_SMART=""
